{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": false,
    "strictPropertyInitialization": false,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "baseUrl": ".",
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@": [
        "src"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "webworker.importscripts"
    ],
    "noImplicitThis": true,
    "strictBindCallApply": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
