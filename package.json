{
  "name": "@sembeacon/app",
  "version": "1.8.1",
  "description": "SemBeacon Application",
  "license": "Apache-2.0",
  "author": {
    "name": "Maxim Van de Wynckel",
    "email": "maxim@mvdw-software.com"
  },
  "scripts": {
    "postinstall": "shx mkdir -p public/js/vendor/openhps && yarn copy:js:openhps && yarn copy:js:sembeacon && node ./scripts/process.js",
    "build": "vite build",
    "build:android": "ionic capacitor build android --prod",
    "build:android:debug": "ionic capacitor build android",
    "build:ci": "ionic capacitor copy android --prod",
    "build:ios": "ionic capacitor build ios --prod",
    "copy:js:openhps": "shx cp -rf node_modules/@openhps/*/dist/web/*.* ./public/js/vendor/openhps/",
    "copy:js:sembeacon": "shx cp -rf node_modules/@sembeacon/*/dist/web/*.* ./public/js/vendor/openhps/",
    "dev": "cross-env VITE_CJS_TRACE=true vite",
    "format": "prettier --write \"src/**/*.{ts,vue,js,css}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,css}\" \"tests/**/*.{ts,js}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ontologies": "openhps-rdf -ns europont:http://elite.polito.it/ontologies/eupont.owl# -d ./src/ontologies",
    "resources": "npx @capacitor/assets generate --splashBackgroundColor #363795 --ios --android --pwa",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "serve": "vite preview",
    "set-version": "capacitor-set-version",
    "start:android": "ionic capacitor run android",
    "start:ios": "ionic capacitor run ios -l --external",
    "sync": "ionic cap sync",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium-mobile --project=webkit-mobile",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "node scripts/playwright-docker.js test --project=visual --update-snapshots",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:vue": "vue-tsc --noEmit",
    "update:dependencies": "ncu -u"
  },
  "dependencies": {
    "@awesome-cordova-plugins/bluetooth-le": "^8.1.0",
    "@awesome-cordova-plugins/core": "^8.1.0",
    "@awesome-cordova-plugins/ibeacon": "^8.1.0",
    "@capacitor-community/bluetooth-le": "^7.1.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/background-runner": "^2.1.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/device": "^7.0.2",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/keyboard": "^7.0.2",
    "@capacitor/local-notifications": "^7.0.2",
    "@capacitor/motion": "^7.0.1",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@capacitor/toast": "^7.0.2",
    "@capawesome-team/capacitor-android-foreground-service": "^7.0.1",
    "@capawesome/capacitor-android-edge-to-edge-support": "^7.2.3",
    "@ionic/core": "^8.7.3",
    "@ionic/vue": "^8.7.3",
    "@ionic/vue-router": "^8.7.3",
    "@maskito/core": "^3.10.3",
    "@maskito/vue": "^3.10.3",
    "@monaco-editor/loader": "^1.5.0",
    "@openhps/capacitor-bluetooth": "^1.0.6",
    "@openhps/capacitor-geolocation": "^1.0.6",
    "@openhps/capacitor-preferences": "^1.0.6",
    "@openhps/capacitor-sensors": "^1.0.6",
    "@openhps/cordova-ibeacon": "^1.0.2",
    "@openhps/core": "^1.0.16",
    "@openhps/geospatial": "^0.1.33",
    "@openhps/localstorage": "^1.0.1",
    "@openhps/rdf": "^1.1.7",
    "@openhps/rf": "^1.0.4",
    "@openhps/solid": "^1.0.3",
    "@sembeacon/openhps": "^1.7.1",
    "@vueuse/core": "^13.8.0",
    "axios": "^1.11.0",
    "bootstrap-icons-vue": "^1.11.3",
    "capacitor-native-settings": "^7.0.2",
    "cordova-plugin-bluetoothle": "https://github.com/SemBeacon/cordova-plugin-bluetoothle",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-ibeacon": "^3.8.1",
    "cross-fetch": "^4.1.0",
    "date-fns": "4.1.0",
    "ionicons": "^8.0.13",
    "monaco-editor": "^0.52.2",
    "monaco-editor-textmate": "^4.0.0",
    "monaco-textmate": "^3.0.1",
    "ol": "^10.6.1",
    "ol-contextmenu": "^5.5.0",
    "ol-ext": "^4.0.34",
    "ol-geocoder": "^4.3.3",
    "ol-mapbox-style": "^13.1.0",
    "onigasm": "^2.2.5",
    "pinia": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "vue": "3.5.20",
    "vue-facing-decorator": "^4.0.1",
    "vue-router": "^4.5.1",
    "vue3-openlayers": "^11.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.3",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@eslint/js": "^9.34.0",
    "@ionic/cli": "^7.2.1",
    "@openhps/fingerprinting": "^0.1.9",
    "@openhps/video": "^1.0.3",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@siedlerchr/types-ol-ext": "3.6.3",
    "@swc/core": "^1.13.5",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "capacitor-set-version": "^2.2.0",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "fast-check": "^4.10.2",
    "globals": "^16.3.0",
    "happy-dom": "^21.0.4",
    "npm-check-updates": "^18.0.3",
    "prettier": "^3.6.2",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.91.0",
    "shx": "^0.4.0",
    "tslib": "^2.8.1",
    "typescript": "5",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^1.5.7",
    "vite": "^7.1.3",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22"
  }
}
