{
    "name": "SemBeacon",
    "dockerFile": "Dockerfile",
    "runArgs": [
        "--privileged",
        "--device=/dev/bus/usb:/dev/bus/usb",
        "--add-host=host.docker.internal:host-gateway"
    ],
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        },
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21"
        },
        "ghcr.io/NordcomInc/devcontainer-features/android-sdk:1.2.0": {
            "platform": "36",
            "build_tools": "36.0.0",
            "base_packages": []
        }
    },
    "containerEnv": {
        "SIGNING_STORE_PASSWORD": "${localEnv:SIGNING_STORE_PASSWORD}",
        "SIGNING_KEY_PASSWORD": "${localEnv:SIGNING_KEY_PASSWORD}",
        "SIGNING_KEY_ALIAS": "${localEnv:SIGNING_KEY_ALIAS}",
        "ANDROID_ADB_SERVER_ADDRESS": "host.docker.internal",
        "ADB_SERVER_SOCKET": "tcp:host.docker.internal:5037"
    },
    "forwardPorts": [
        8085
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ms-vscode.vscode-typescript-next",
                "msjsdiag.debugger-for-chrome",
                "ionic.ionic",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "Ionic.ionic",
                "Vue.volar",
                "hollowtree.vue-snippets",
                "johnpapa.vscode-peacock",
                "PKief.material-icon-theme",
                "github.vscode-github-actions",
                "ms-azuretools.vscode-docker",
                "donjayamanne.git-extension-pack"
            ]
        }
    },
    "postCreateCommand": "yarn install"
}