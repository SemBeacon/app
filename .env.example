# Copy to .env (gitignored). VITE_MAPBOX_TOKEN is required for maps; the rest are optional
# overrides of the external services (defaults in src/config.ts)
# VITE_SHORTENER_URL=https://s.sembeacon.org/shorten?api=...
# VITE_CORS_PROXY_URL=https://proxy.sembeacon.org/?api=...&uri=
VITE_MAPBOX_TOKEN=

# Show demo beacons on start-up (emulator/simulator tests, screenshots); never for releases
# VITE_DEMO_MODE=true
